# Public demo URL used by cookies, redirects, and payment return URLs.
SANDBOX_PUBLIC_ORIGIN=https://demo.your-domain.com

# Change before exposing publicly.
SANDBOX_POSTGRES_PASSWORD=change_me
SANDBOX_SESSION_SECRET=change_me_with_openssl_rand_base64_48
# Leave blank for the public demo. Set only if you explicitly need private admin access.
SANDBOX_SUPER_ADMIN_ACCOUNTS=
SANDBOX_DEMO_LOGIN_EMAIL=demo@roomio.local
SANDBOX_DEMO_LOGIN_AUTOPROVISION=true

# Local-only ports. Expose the web port via Cloudflare Tunnel or host Nginx.
SANDBOX_WEB_PORT=8083
SANDBOX_API_PORT=3001

# 1 vCPU friendly defaults. Raise API/DB slightly if the demo feels too slow.
SANDBOX_API_CPUS=0.30
SANDBOX_DB_CPUS=0.30
SANDBOX_WEB_CPUS=0.10
SANDBOX_API_MEMORY=512m
SANDBOX_DB_MEMORY=768m
SANDBOX_WEB_MEMORY=128m
SANDBOX_NODE_OPTIONS=--max-old-space-size=256
SANDBOX_UV_THREADPOOL_SIZE=2

# Optional integrations. Keep blank for a safe public sandbox.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_ENC_KEY=
PAYOS_PARTNER_CODE=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRES_SECONDS=300
R2_UPLOAD_MAX_BYTES=5242880

BOT_TOKEN=
BOT_USERNAME=
MINIAPP_SHORT_NAME=
